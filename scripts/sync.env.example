# Credentials for the unattended weekly Liked-mirror sync (scripts/run_sync.sh).
# Copy this to ~/.config/flowstate/sync.env and fill in your values, then `chmod 600` it.
# These come from your Spotify app at https://developer.spotify.com/dashboard.
SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_CLIENT_SECRET=your-client-secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
