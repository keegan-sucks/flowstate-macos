# Credentials for the unattended weekly Liked-mirror sync (scripts/run_sync.sh).
# Copy this to ~/.config/flowstate/sync.env and fill in your Client ID, then chmod 600.
# From your Spotify app at https://developer.spotify.com/dashboard.
#
# PKCE flow — only a Client ID is needed. There is NO client secret.
SPOTIPY_CLIENT_ID=your-client-id
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
